{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": [
      "/((?!api/|assets/).*)"
    ]
  },
  "rewrites": [
    {
      "source": "/w/:slug",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/w/:slug/",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/w/:slug/:page*",
      "destination": "/api/site?slug=:slug&page=:page*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
