{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": [
      "/((?!api/|assets/).*)"
    ]
  },
  "rewrites": [
    {
      "source": "/w/:slug",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/w/:slug/",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/w/:slug/:page*",
      "destination": "/api/site?slug=:slug&page=:page*"
    },
    {
      "source": "/ratgeber",
      "destination": "/api/ratgeber"
    },
    {
      "source": "/ratgeber/",
      "destination": "/api/ratgeber"
    },
    {
      "source": "/ratgeber/:slug",
      "destination": "/api/ratgeber?slug=:slug"
    },
    {
      "source": "/:page(maler-software|aufmass-angebote|auftragsverwaltung|zeiterfassung|materialverwaltung|rechnungen|kundenportal|leistungsbewertung|fachkraefte|buchhaltung|ki-telefon|firmen-website|fachkraefte-finden|auswertungen|werbung-mit-ki)",
      "destination": "/seo/:page/index.html"
    },
    {
      "source": "/:page(maler-software|aufmass-angebote|auftragsverwaltung|zeiterfassung|materialverwaltung|rechnungen|kundenportal|leistungsbewertung|fachkraefte|buchhaltung|ki-telefon|firmen-website|fachkraefte-finden|auswertungen|werbung-mit-ki)/",
      "destination": "/seo/:page/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
