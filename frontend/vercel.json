{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": [
      "/((?!api/|assets/).*)"
    ]
  },
  "rewrites": [
    {
      "source": "/w/:slug",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/w/:slug/",
      "destination": "/api/site?slug=:slug"
    },
    {
      "source": "/w/:slug/:page*",
      "destination": "/api/site?slug=:slug&page=:page*"
    },
    {
      "source": "/:page(maler-software|aufmass-angebote|auftragsverwaltung|zeiterfassung|materialverwaltung|rechnungen|kundenportal|leistungsbewertung|fachkraefte|buchhaltung|ki-telefon|firmen-website|fachkraefte-finden|auswertungen)",
      "destination": "/seo/:page/index.html"
    },
    {
      "source": "/:page(maler-software|aufmass-angebote|auftragsverwaltung|zeiterfassung|materialverwaltung|rechnungen|kundenportal|leistungsbewertung|fachkraefte|buchhaltung|ki-telefon|firmen-website|fachkraefte-finden|auswertungen)/",
      "destination": "/seo/:page/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/app.html"
    }
  ]
}
